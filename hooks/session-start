#!/usr/bin/env bash
# SessionStart hook for Vanta plugin — emits the live project brief.
#
# The static using-vanta protocol is already loaded via CLAUDE.md @-import. This
# hook's job is the DYNAMIC piece that protocol describes: branch, phase,
# recent decisions, stale signals, pending shadow reviews — all computed live
# at session start by bin/vanta-brief.js.
#
# v3.3 had a static dump of using-vanta SKILL.md here; both councils flagged
# that the brief described inside that skill was never actually computed.
# v3.4 fixes the delivery loop.

set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
BRIEF_BIN_DEPLOYED="${HOME}/.claude/bin/vanta-brief.js"
BRIEF_BIN_REPO="${HOME}/Projects/vanta/bin/vanta-brief.js"

# Resolve brief generator: prefer deployed, fall back to repo location.
BRIEF_BIN=""
[ -f "$BRIEF_BIN_DEPLOYED" ] && BRIEF_BIN="$BRIEF_BIN_DEPLOYED"
[ -z "$BRIEF_BIN" ] && [ -f "$BRIEF_BIN_REPO" ] && BRIEF_BIN="$BRIEF_BIN_REPO"

# If we have no generator, exit silently — never break session start.
if [ -z "$BRIEF_BIN" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":""}}'
  exit 0
fi

# Read cwd from stdin JSON (Claude Code SessionStart input format).
#
# Gemini council R5 P2 fix — `read -r` (even with -t) only consumes a single
# line. Claude Code can deliver pretty-printed multi-line JSON; the older
# `read` approach silently dropped everything past the first newline and
# every cwd extraction failed → fell back to $PWD. `cat` with a 2s timeout
# guarded by `timeout` consumes the entire payload.
# Codex council R10 P1 — `timeout` is GNU coreutils, not on stock macOS.
# Stock macOS users would see this hook silently fail every SessionStart
# because `timeout` returns a "command not found" error, the `|| echo ""`
# absorbs it, and input_json stays empty. Probe the command first:
# - GNU `timeout` (Linux, macOS via brew/coreutils)
# - `gtimeout` (macOS via brew prefix)
# - direct cat (no timeout, but session-start has Claude's own 5s budget)
input_json=""
if [ -t 0 ]; then
  input_json=""
elif command -v timeout >/dev/null 2>&1; then
  input_json=$(timeout 2 cat 2>/dev/null || echo "")
elif command -v gtimeout >/dev/null 2>&1; then
  input_json=$(gtimeout 2 cat 2>/dev/null || echo "")
else
  # No timeout available — read stdin directly. Claude Code's own
  # 5s SessionStart budget prevents runaway. Worst case the cat
  # blocks until parent closes stdin, which is fast for SessionStart.
  input_json=$(cat 2>/dev/null || echo "")
fi
cwd=""
if [ -n "$input_json" ]; then
  cwd=$(printf '%s' "$input_json" | python3 -c "import json,sys; d=json.loads(sys.stdin.read() or '{}'); print(d.get('cwd', ''))" 2>/dev/null || echo "")
fi
[ -z "$cwd" ] && cwd="$PWD"

# Run brief with implicit Node timeout (the script is fast — no stale data
# blocks session start). On any error, emit empty additionalContext.
#
# R11 P1 / R12 P2 — Codex council finding (R12). The R11 fix piped raw
# Node stderr to hook.log, but vanta-status only parses structured
# `ISO | LEVEL | source | message` lines. Raw stderr stayed invisible
# in the status surface. Now: pipe stderr through a wrapper that emits
# the structured format so brief failures are first-class signals
# vanta-status can count and surface.
HOOK_LOG="$HOME/.vanta/hook.log"
mkdir -p "$(dirname "$HOOK_LOG")" 2>/dev/null || true
brief_lines=""
if [ -d "$cwd" ]; then
  # Wrap each stderr line in the structured `ISO | ERROR | source | msg`
  # shape vanta-status's hook-log reader expects. Python is portable
  # across Linux + stock macOS (gawk's strftime is not).
  brief_lines=$(node "$BRIEF_BIN" --cwd "$cwd" 2> >(python3 -u -c '
import sys, datetime
for line in sys.stdin:
    line = line.rstrip("\n")
    if not line: continue
    ts = datetime.datetime.utcnow().isoformat(timespec="seconds") + "Z"
    print(f"{ts} | ERROR | session-start.brief | {line}", flush=True)
' >>"$HOOK_LOG") || true)
fi

if [ -z "$brief_lines" ]; then
  printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":""}}'
  exit 0
fi

escape_for_json() {
  local s="$1"
  s="${s//\\/\\\\}"
  s="${s//\"/\\\"}"
  s="${s//$'\n'/\\n}"
  s="${s//$'\r'/\\r}"
  s="${s//$'\t'/\\t}"
  printf '%s' "$s"
}

escaped=$(escape_for_json "$brief_lines")
printf '{"hookSpecificOutput":{"hookEventName":"SessionStart","additionalContext":"%s"}}' "$escaped"
